{
  "name": "minshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev -c dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "node --experimental-strip-types scripts/deploy.mjs",
    "deploy:ci": "node --experimental-strip-types scripts/deploy.mjs --skip-build",
    "check": "node scripts/theme-sync.mjs && astro check",
    "test": "node scripts/theme-sync.mjs && vp test run",
    "test:watch": "vp test",
    "test:integration": "node --experimental-strip-types test/integration/reservations.mjs && node --experimental-strip-types test/integration/refunds.mjs && node --experimental-strip-types test/integration/media.mjs && node --experimental-strip-types test/integration/menus.mjs && node --experimental-strip-types test/integration/guest-access.mjs && node --experimental-strip-types test/integration/shipping.mjs && bash test/integration/d1-integration.sh",
    "test:d1": "astro build && vp run test:integration",
    "test:storefront-equivalence": "astro build && bash test/integration/storefront-baselines.sh",
    "test:storefront-contract": "vp test run test/storefront",
    "theme:check": "node scripts/check-themes.mjs",
    "verify": "node scripts/theme-sync.mjs && vp test run && astro check && node scripts/check-themes.mjs && astro build && node scripts/check-built-css.mjs && vp run test:integration && node --experimental-strip-types scripts/check-stripe-countries.mjs && vp run mcp:check",
    "verify:theme": "node scripts/verify-theme.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./seed.sql",
    "provision:cf": "bash scripts/provision-cf.sh",
    "provision:local": "bash scripts/provision-local.sh",
    "destroy:cf": "bash scripts/destroy-cf.sh",
    "destroy:local": "bash scripts/destroy-local.sh",
    "admin:reset": "bash scripts/admin-reset.sh",
    "admin:reset:remote": "bash scripts/admin-reset.sh --remote",
    "reset:local": "bash scripts/reset.sh",
    "reset:remote": "bash scripts/reset.sh --remote",
    "mcp:dev": "wrangler dev --config mcp/wrangler.jsonc --persist-to .wrangler/state",
    "mcp:deploy": "wrangler deploy --config mcp/wrangler.jsonc",
    "mcp:check": "bash scripts/check-mcp.sh",
    "theme:sync": "node scripts/theme-sync.mjs",
    "db:seed:storefront-states": "bash scripts/seed-storefront-states.sh",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "astro": "^7.1.6",
    "markdown-it": "^15.0.0",
    "stripe": "^22.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@oxlint/plugins": "1.79.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "miniflare": "^4.20260730.0",
    "oxlint": "1.79.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.0"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.25.0"
}
